{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "node",
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@sentinel/*": ["libs/*/src"]
    }
  },
  "include": ["services/**/*.ts", "libs/**/*.ts", "scripts/**/*.ts", "tests/**/*.ts"]
}
