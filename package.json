{
  "name": "sentinel",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "services/*",
    "libs/*",
    "web"
  ],
  "scripts": {
    "build": "sam build -t infra/template.yaml",
    "deploy": "sam deploy --guided -t infra/template.yaml",
    "test": "jest",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "demo": "ts-node scripts/demo-generate-events.ts",
    "replay-dlq": "ts-node scripts/replay-dlq.ts",
    "load-test": "ts-node scripts/load-test.ts",
    "web:dev": "npm --workspace web run dev",
    "web:build": "npm --workspace web run build",
    "web:test": "npm --workspace web run test"
  },
  "dependencies": {
    "@aws-sdk/client-cloudwatch": "^3.995.0",
    "@aws-sdk/client-dynamodb": "^3.995.0",
    "@aws-sdk/client-eventbridge": "^3.995.0",
    "@aws-sdk/client-sns": "^3.995.0",
    "@aws-sdk/client-sqs": "^3.995.0",
    "@aws-sdk/lib-dynamodb": "^3.995.0",
    "@aws-sdk/util-dynamodb": "^3.995.0",
    "ajv": "^8.18.0",
    "ajv-formats": "^3.0.1",
    "aws-xray-sdk-core": "^3.5.0",
    "esbuild": "^0.27.2",
    "jose": "^6.0.12",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/autocannon": "^7.12.7",
    "@types/aws-lambda": "^8.10.122",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.11.30",
    "autocannon": "^7.12.0",
    "jest": "^30.2.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.2"
  },
  "overrides": {
    "glob": "^11.0.0",
    "minimatch": "^10.2.1"
  }
}
